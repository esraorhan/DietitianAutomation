@model AppoinmentCalendarViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Page title and tab -->
<div class="section-body">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center ">
            <div class="header-action">
                <h1 class="page-title">Calendar</h1>
                <ol class="breadcrumb page-breadcrumb">
                    <li class="breadcrumb-item"><a href="#">Ericsson</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Calendar</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<div class="section-body mt-4">
    <div class="container-fluid">
        <div class="row clearfix row-deck">
            <div class="col-lg-4 col-md-12">
                <div class="card">
                    <div class="card-body">
                        <h3 class="card-title">Randevu Listesi</h3>
                        <a onclick="showInPopup('@Url.Action("Add","Appointments")','Randevu Oluştur')" class="btn btn-primary text-light m-2"><i class="fa fa-plus-circle"></i>  Randevu Oluştur</a>
                       
                        <div id="event-list" class="fc event_list">

                            <div class='fc-event bg-primary' data-class="bg-primary">Etkinliğim 1</div>
                            <div class='fc-event bg-info' data-class="bg-info">Doğum günü partisi</div>
                            <div class='fc-event bg-success' data-class="bg-success">Toplantı</div>
                            <div class='fc-event bg-warning' data-class="bg-warning">Konferans</div>
                            <div class='fc-event bg-danger' data-class="bg-danger">Etkinliğim 5</div>
                        </div>
                   
                    </div>
                </div>
            </div>
            <div class="col-lg-8 col-md-12">
                <div class="card">
                    <div class="card-body">
                        <div id="calendar"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="centermodal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myCenterModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">x</button>
            </div>
            <div class="modal-body">

            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
@section grafikscript{

    <script>

        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar')
            const calendar = new FullCalendar.Calendar(calendarEl, {
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth'
                },
                weekNumbers: true,
                dayMaxEvents: true, // allow "more" link when too many events
                locale: 'tr',
                lang: 'tr',
                editable: true,
                eventSources: [{
                    url: '/Appointments/GetData',
                    method: 'POST',
                    success: function (response) {
                        console.log(response);
                        return response.data;
                    },
                    failure: function () {
                        alert('Etkinlikler alınırken bir hata oluştu!')
                    }
                }
                ]
            });
            calendar.render()
        });

    </script>
}

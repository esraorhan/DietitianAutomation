@model GeneralDietListViewModel
<div class="card p-5">
    <form asp-controller="DietLists" asp-action="AddGeneralDiet" method="post">
        @Html.AntiForgeryToken()

        <div class="form-group row">
            <label class="col-md-3 col-form-label">Diyet Başlık <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="text" asp-for="GeneralDietList.DietName" class="form-control">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-3 col-form-label">Açıklama <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="text" asp-for="GeneralDietList.Description" class="form-control">
            </div>
        </div>
        <div class="form-group row">
            <label class="col-md-3 col-form-label">Tahmini Kalori <span class="text-danger">*</span></label>
            <div class="col-md-9">
                <input type="text" asp-for="GeneralDietList.TotalCalories" class="form-control">
            </div>
        </div>
        @*<div class="form-group row">
            <label class="col-md-3 col-form-label">Danışan <span class="text-danger"></span></label>
            <div class="col-md-9">
                <small class="text-primary">bu kısımda kişiye atama yapabilirsiniz veya atama yapmadan da şablon oluşturabilirsiniz</small>
                <select class="form-control input-height" asp-for="GeneralDietList.AdultCustomerID" id="foodId" asp-items="Model.Customers">
                    <option value="">Seçiniz...</option>
                </select>
            </div>
        </div>*@
        <div class="row">
            <p><small class="text-danger">Öncelikle Şablon oluşturup sonrasında diyet oluşturmanız gerekir. </small></p> 
            <button type="submit" class="btn btn-primary ">Ekle</button>
        </div>


    </form>
</div>
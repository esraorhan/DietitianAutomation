@model AdultCustomerViewModel
    <!-- Plugins css -->
   
    <div class="card-body">
        <form asp-controller="Customers" asp-action="Edit" method="post">
            <div class="row clearfix">
                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Adı Soyadı <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <span class="text-danger" asp-validation-for="AdultCustomer.FullName"></span>
                        <input type="text" class="form-control" asp-for="AdultCustomer.FullName" placeholder="Adı Soyadı">
                        <input type="hidden" asp-for="AdultCustomer.AdultCustomerID" />
                        <input type="hidden" asp-for="AdultCustomer.StartingDate"  />
                        <input type="hidden" asp-for="AdultCustomer.Age"  />
                        <input type="hidden" asp-for="AdultCustomer.UserId"  />
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Mail <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.Mail" placeholder="E-mail">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Telefon <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <span class="text-danger" asp-validation-for="AdultCustomer.Phone"></span>
                        <input type="number" class="form-control" asp-for="AdultCustomer.Phone" placeholder="Telefon No">
                    </div>
                </div>


                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Kilo <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <span class="text-danger" asp-validation-for="AdultCustomer.Kilo"></span>
                        <input type="text" class="form-control" asp-for="AdultCustomer.Kilo" placeholder="KG">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Boy(cm) <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <span class="text-danger" asp-validation-for="AdultCustomer.Size"></span>
                        <input type="text" class="form-control" asp-for="AdultCustomer.Size" placeholder="Boy(cm)">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Doğum tarihi <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <span class="text-danger" asp-validation-for="AdultCustomer.DateOfBirth"></span>
                        @*<input data-provide="datepicker"  asp-for="AdultCustomer.DateOfBirth" class="form-control" placeholder="Doğum Tarihi">*@
                        <input type="date" class="form-control" placeholder="Doğum Tarihi" asp-for="AdultCustomer.DateOfBirth">
                    </div>
                </div>


                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Cinsiyet <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <select asp-for="AdultCustomer.Gender" class="form-control" required>
                            <option value="">Seçiniz</option>
                            <option value="Kadın">Kadın</option>
                            <option value="Erkek">Erkek</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Mesleğiniz <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.Job" placeholder="Mesleğiniz">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">Hedef Kilo <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.CustomerTarget" placeholder="hedef">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-4 col-form-label">Çalışma Şekli <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <select asp-for="AdultCustomer.MannerOfWork" class="form-control">
                            <option value="HAREKETSİZ - AYDA 1-2 GÜN EGZERSİZ">HAREKETSİZ - AYDA 1-2 GÜN EGZERSİZ</option>
                            <option value="AZ HAREKETLİ - AYDA 1-3 GÜN EGZERSİZ">AZ HAREKETLİ - AYDA 1-3 GÜN EGZERSİZ</option>
                            <option value="ORTA DERECE HAREKETLİ - AYDA 3-5 GÜN EGZERSİZ">ORTA DERECE HAREKETLİ - AYDA 3-5 GÜN EGZERSİZ</option>
                            <option value="ÇOK HAREKETLİ - AYDA 6-7 GÜN EGZERSİZ">ÇOK HAREKETLİ - AYDA 6-7 GÜN EGZERSİZ</option>
                            <option value="Yüksek Lisans">AŞIRI HAREKETLİ - YOĞUN EĞZERSİZ</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Genetik Rahatsızlıklar <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.GeneticDisease" placeholder="Genetik hastalıklar">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Alerjiniz var mı? <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.Allergy" placeholder="Alerjileriniz">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Alkol Kullanılıyor mu? <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <select asp-for="AdultCustomer.AlcoholUse" class="form-control">
                            <option value="true">Evet</option>
                            <option value="false">Hayır</option>
                        </select>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-6 col-form-label">Resim <span class="text-danger">*</span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" placeholder="Resim Yükleyin">
                    </div>
                </div>
                <!--<div class="col-sm-6">
                    <label class="col-md-4 col-form-label">BMH Değeri <span class="text-danger"></span></label>
                    <div class="form-group">
                        <input type="text" class="form-control" asp-for="AdultCustomer.BMH_value" name="bmh" placeholder="BMH Değeri">
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="col-md-3 col-form-label">PAL Değeri</label>
                    <div class="form-group">-->
                @*<span class="text-danger" asp-validation-for="AdultCustomer.PAL_value"></span>*@
                <!--<input type="text" class="form-control" asp-for="AdultCustomer.PAL_value" placeholder="PAL Değeri">
                    </div>
                </div>-->
                <div class="col-sm-12">
                    <label class="col-md-3 col-form-label">Notlar <span class="text-danger">*</span></label>
                    <span class="text-danger" asp-validation-for="AdultCustomer.Description"></span>
                    <div class="form-group">
                        <textarea rows="4" class="summernote" asp-for="AdultCustomer.Description"></textarea>
                    </div>
                </div>
                <div class="col-sm-12">
                    <button type="submit" class="btn btn-primary float-right">Kaydet</button>
                </div>
            </div>
        </form>
    </div>
  
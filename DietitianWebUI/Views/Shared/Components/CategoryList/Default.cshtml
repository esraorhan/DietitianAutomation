@model CategoryViewModel
<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover js-basic-example dataTable table-striped table_custom border-style spacing5">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Kategori Adı</th>
                        <th>Açıklama</th>
                       
                        <th>Düzenle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null)
                    {

                    }
                    else
                    {
                        int a = 1;
                        @foreach (var item in Model.Categories)
                        {
                            <tr>
                                <td>@a</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Description</td>                              
                                <td>
                                    <a type="button" onclick="showInPopup('@Url.Action("Edit","Category",new {categoryId=item.CategoryID})','Kategori Güncelle')" class="btn btn-icon btn-sm" title="Düzenle"><i class="fa fa-edit"></i></a>
                                    <a type="button" href="@Url.Action("Delete","Category",new {categoryId=item.CategoryID})" class="btn btn-icon btn-sm" title="Sil"><i class="fa fa-trash-o text-danger"></i></a>
                                </td>
                            </tr>
                            a++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
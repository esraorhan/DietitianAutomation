@model FoodViewModal

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover js-basic-example dataTable table-striped table_custom border-style spacing5">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Besin Adı</th>
                        <th>Ölçüsü </th>
                        <th>Kategorisi</th>
                        <th>Kalori</th>
                        <th>Karbonhidrat</th>
                        <th>Protein</th>
                        <th>Yağ</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null)
                    {

                    }
                    else
                    {
                        int a = 1;
                        @foreach (var item in Model.Foods)
                        {
                            <tr>
                                <td>@a</td>
                                <td>@item.FoodName </td>
                                <td>@item.Amount  @item.UnitOfMeasure</td>
                                <td>@item.CategoryName</td>
                                <td>@item.Calorie</td>
                                <td>@item.Carbohydrate</td>
                                <td>@item.Protein</td>
                                <td>@item.Oil</td>
                                <td>
                                    <a type="button" onclick="showInPopup('@Url.Action("Edit","Food",new {foodId=item.FoodID})','Besin Güncelle')" class="btn btn-icon btn-sm" title="Düzenle"><i class="fa fa-edit"></i></a>
                                    <a type="button" href="@Url.Action("Delete","Food",new {foodId=item.FoodID})" class="btn btn-icon btn-sm" title="Sil"><i class="fa fa-trash-o text-danger"></i></a>
                                </td>
                            </tr>
                            a++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

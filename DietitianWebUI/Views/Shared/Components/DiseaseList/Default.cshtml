@model DiseaseViewModel

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover js-basic-example dataTable table-striped table_custom border-style spacing5">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Hastalık Adı</th>
                        <th>Enerji</th>
                        <th>Protein</th>
                        <th>Düzenle</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null)
                    {

                    }
                    else
                    {
                        int a = 1;
                        @foreach (var item in Model.Diseases)
                        {
                            <tr>
                                <td>@a</td>
                                <td>@item.DiseaseName</td>
                                <td>@Html.Raw(item.Energy)</td>
                                <td>@Html.Raw(item.Protein)</td>
                                <td>
                                    <a type="button" href="@Url.Action("Edit","Disease",new {diseaseId=item.DiseaseId})" class="btn btn-icon btn-sm" title="Düzenle"><i class="fa fa-edit"></i></a>
                                    <a type="button" href="@Url.Action("Delete","Disease",new {diseaseId=item.DiseaseId})" class="btn btn-icon btn-sm" title="Sil"><i class="fa fa-trash-o text-danger"></i></a>
                                </td>
                            </tr>
                            a++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
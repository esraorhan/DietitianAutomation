@model CustomerProfileViewModel
@using Microsoft.AspNetCore.Http
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*@await Component.InvokeAsync("CustomerProfileInformation" ,new { CustomerId = HttpContextAccessor.HttpContext.Session.GetInt32("customerId") })*@
<div class="container-fluid">
    <div class="row row-deck">
        <div class="col-sm-12 col-lg-6 mx-auto">
            <div class="card ">
                <div class="card-status bg-blue"></div>
                <div class="card-body">
                    <div class="table-responsive table-sm" style="height: 310px;">
                        <table class="table card-table table-sm table-vcenter text-nowrap table-striped mb-0">
                            <tbody>
                                <tr>
                                    <th>Hastalık Adı</th>
                                    <th>Enerji</th>
                                    <th>Protein</th>
                                    <th>Karbonhidrat</th>
                                    <th>Yağ</th>
                                    <th>Vitamin ve Mineral</th>
                                    <th>Posa</th>
                                    <th>Alkol</th>
                                    <th>Sıvı</th>
                                    <th>Öğün</th>
                                    <th>Tuz</th>
                                </tr>
                                @if (Model.Diseases != null)
                                {
                                    foreach (var item in Model.Diseases)
                                    {
                                        <tr>
                                            <td class="font-weight-bold">@item.DiseaseName</td>
                                            <td>@Html.Raw(item.Energy)</td>
                                            <td>@Html.Raw(item.Protein)</td>
                                            <td>@Html.Raw(item.Carbohydrate)</td>
                                            <td>@Html.Raw(item.Oil)</td>
                                            <td>@Html.Raw(item.VitaminMineral)</td>
                                            <td>@Html.Raw(item.Posa)</td>
                                            <td>@Html.Raw(item.Alcohol)</td>
                                            <td>@Html.Raw(item.Water)</td>
                                            <td>@Html.Raw(item.Meal)</td>
                                            <td>@Html.Raw(item.Salt)</td>
                                        </tr>
                                    }
                                }


                            </tbody>
                        </table>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-sm-12 col-lg-3 mx-auto">
            <div class="card ">
                <div class="card-status bg-green"></div>
                <div class="card-body">
                    <div class="card-category text-success">@Model.AdultCustomerDetail.FullName</div>
                    <div class="display-5 my-2">@Model.AdultCustomerDetail.Kilo kg</div>
                    <ul class="list-unstyled leading-loose">
                        <li>@Model.AdultCustomerDetail.Age Yaşında</li>
                        <li><i class="fe fe-check text-success mr-2" aria-hidden="true"></i> <b class="text-primary font-20">@Model.AdultCustomerDetail.Vki_value</b>  vücut kitle indeksi</li>
                        <li><i class="fe fe-check text-success mr-2" aria-hidden="true"></i> <b class="text-primary font-20">@Model.AdultCustomerDetail.Vki_comment</b></li>
                        <li><i class="fe fe-check text-success mr-2" aria-hidden="true"></i> <b class="text-primary font-20"> @Model.AdultCustomerDetail.BMH_value</b> kcal bazal metobolizma hızınız</li>
                        <li><i class="fe fe-check text-success mr-2" aria-hidden="true"></i> @Model.AdultCustomerDetail.BodyFatIndex Vucut yağ Oranı</li>
                    </ul>

                </div>
            </div>
        </div>
        <div class="col-sm-12 col-lg-3 mx-auto">
            <div class="card ">
                <div class="card-status bg-pink"></div>
                <div class="card-body">
                    <div class="card-category text-danger">Hasta Öyküsü</div>
                    <div class="h6 my-2">@Model.AdultCustomerDetail.Job</div>
                    <ul class="list-unstyled leading-loose">
                        <li>@Model.AdultCustomerDetail.MannerOfWork </li>
                        <li><i class="fe fe-bookmark text-success mr-2" aria-hidden="true"></i>Hastalık: @Model.AdultCustomerDetail.GeneticDisease  </li>
                        <li><i class="fe fe-bookmark text-success mr-2" aria-hidden="true"></i>Alerji: @Model.AdultCustomerDetail.Allergy </li>
                        <li><i class="fe fe-bookmark text-success mr-2" aria-hidden="true"></i>Notlar: @Html.Raw(Model.AdultCustomerDetail.Description) </li>
                        @*<li><i class="fe fe-check text-success mr-2" aria-hidden="true"></i> @Model.AdultCustomerDetail.BodyFatIndex Vucut yağ Oranı</li>*@
                    </ul>

                </div>
            </div>
        </div>
    </div>
</div>


<div class="section-body">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center ">
            <div class="header-action">

            </div>
            <ul class="nav nav-tabs page-header-tab">
                <li class="nav-item"><a class="nav-link " data-toggle="tab" href="#Gorusmeler">Görüşmeler</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#Staff-grid">Diyet Programları</a></li>
                <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#Grafikler">Vucut Ölçüleri</a></li>
                <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#Dosyalar">Dosyalar</a></li>
            </ul>
        </div>
    </div>
</div>

<div class="section-body mt-4">
    <div class="container-fluid">
        <div class="tab-content">
            <div class="tab-pane" id="Gorusmeler">
                <div class="row mb-3">
                    <div class="col-12">
                        <a type="submit" onclick="showInPopup('@Url.Action("AddNewMeeting","CustomerProfile",new {customerId=Model.AdultCustomerDetail.AdultCustomerID })','Yeni Görüşme Ekle')" class="btn btn-sm text-light btn-primary float-lg-right"> <i class="fe fe-plus-circle text-light mr-2" aria-hidden="true"></i>Yeni Görüşme Ekle</a>

                    </div>
                </div>
                @await Component.InvokeAsync("AdultMeetingsList", Model.AdultCustomerDetail.AdultCustomerID)

            </div>
            <div class="tab-pane" id="Staff-grid">
                <div class="row">
                    <div class="row mb-3">
                        <div class="col-12">
                            <a type="submit" onclick="showInPopup('@Url.Action("AddCustomerDietList","CustomerProfile",new {customerId=Model.AdultCustomerDetail.AdultCustomerID })','Diyet Programı')" class="btn btn-sm text-light btn-primary float-lg-right"><i class="fe fe-plus-circle text-light mr-2" aria-hidden="true"></i> Diyet Programı Oluştur</a>

                        </div>
                    </div>
                    @*<div class="col-xl-3 col-lg-4 col-md-6">
                            <div class="card">
                                <div class="card-body text-center">
                                    <img class="card-profile-img" src="~/assets/images/sm/avatar1.jpg" alt="">
                                    <h5 class="mb-0">Peter Richards</h5>
                                    <span>Librarian</span>
                                    <div class="text-muted">+ (916) 369-7180</div>
                                    <p class="mb-4 mt-3">449 Thompson St, Conway, SC, 29527</p>
                                    <button class="btn btn-primary btn-sm">Read More</button>
                                </div>
                            </div>
                        </div>*@

                </div>
            </div>
            <div class="tab-pane" id="Grafikler">
                <div class="row">
                    <div class="col-xl-6 col-lg-4 col-md-6">
                        <canvas id="chartdiv" style="width:600px; height:400px;">
                        </canvas>
                    </div>
                    <div class="col-xl-6 col-lg-4 col-md-6">
                        <canvas id="chartBelCM" style="width:600px; height:400px;">
                        </canvas>
                    </div>
                    <div class="col-xl-6 col-lg-4 col-md-6">
                        <canvas id="chartKalcaCM" style="width:600px; height:400px;">
                        </canvas>
                    </div>
                    <div class="col-xl-6 col-lg-4 col-md-6">
                        <canvas id="Yagorani" style="width:600px; height:400px;">
                        </canvas>
                    </div>
                </div>
            </div>
            <div class="tab-pane active" id="Dosyalar">
                <div class="row mb-3">
                    <div class="col-12">
                        <a type="submit" onclick="showInPopup('@Url.Action("AddFolder","CustomerProfile",new {customerId=Model.AdultCustomerDetail.AdultCustomerID})','Yeni tahlil')" class="btn btn-sm btn-primary text-light float-lg-right"> <i class="fe fe-plus-circle text-light mr-2" aria-hidden="true"></i> Dosya Yükle</a>

                    </div>
                </div>
                <div class="row clearfix">
                    @await Component.InvokeAsync("CustomerFolderList", Model.AdultCustomerDetail.AdultCustomerID)
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="centermodal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="myCenterModalLabel"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">x</button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("AddNewMeetingModal")
                @await Html.PartialAsync("AddFolderModal")

            </div>
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /.modal -->
@section grafikscript{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
    $(document).ready(function () {

          $.ajax({
            url: "@Url.Action("Graphics", "CustomerProfile", new { customerId = Model.AdultCustomerDetail.AdultCustomerID })",
            type: "GET",
            dataType: "json",
            contentType: "application/json",
              success: function (result) {
                  console.log(result.kilo);
                  ChartJSRes(result.kilo, "Kilo", "KiLO(KG)", "chartdiv");
                  ChartJSRes(result.yagOrani, "Yağ Oranı", "Yağ(%)", "Yagorani");
                  ChartJSRes(result.kalca, "Kalça Ölçüsü", "KALÇA(CM)", "chartKalcaCM");
                  ChartJSRes(result.bel, "Bel Ölçüsü", "BEL(CM)", "chartBelCM");
            }
        });

    });
   function ChartJSRes(result,label,text,div_id) {

            //  console.log(result);
            var labels = [];
            var dataresults = [];
            $.each(result, function (index, item) {
                labels.push(item.tarih);
                dataresults.push(item.deger);
            });


       const ctx = document.getElementById(div_id).getContext('2d');

            const myChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels, //tarih adı
                    datasets: [{
                        label: label,
                        data: dataresults,
                        backgroundColor: [
                            'rgba(255, 99, 132, 0.5)',
                            'rgba(54, 162, 235, 0.5)',
                            'rgba(255, 206, 86, 0.5)',
                            'rgba(75, 192, 192, 0.5)',
                            'rgba(235, 45,0, 0.5)',
                            'rgba(255, 159, 64, 0.5)',
                            'rgba(135, 48, 36,0.5)',
                            'rgba(36, 135, 70,0.5)',
                            'rgba(100, 70, 189,0.5)',
                            'rgba(0 ,139 ,139,0.5)',
                            'rgba(75 ,0,130,0.5)',
                            'rgba(166 ,69,12,0.5)',
                            'rgba(245 ,1,1,0.5)'

                        ],
                        borderColor: [
                            'rgba(255, 99, 132, 1)',
                            'rgba(54, 162, 235, 1)',
                            'rgba(255, 206, 86, 1)',
                            'rgba(75, 192, 192, 1)',
                            'rgba(153, 102, 255, 1)',
                            'rgba(255, 159, 64, 1)',
                            'rgba(135, 48, 36,1)',
                            'rgba(36, 135, 70,1)',
                            'rgb(100, 70, 189,1)',
                            'rgb(0 ,139 ,139,1)',
                            'rgb(75 ,0,130,1)',
                            'rgba(166 ,69,12,1)',
                            'rgba(245 ,1,1,1)'
                        ],
                        borderWidth: 1
                    }]
                },
                options: {
                    plugins: {
                        title: {
                            display: true,
                            text: text
                        }
                    },
                    scale: {
                        reverse: true,

                        xAxes: [{
                            display: true,
                            type: 'time',
                            time: {
                                parser: 'DD/MM/YYYY',
                                unit: 'day',
                                unitStepSize: 1,
                                displayFormats: {
                                    'day': 'DD/MM/YYYY'
                                }
                            }
                        }
                        ],
                        yAxes: [{ ticks: { min: 0, max: 120 } }],
                    }
                }

            });
        }
    </script>
}
@model CustomerProfileViewModel
<div class="tab-pane" id="pro-add">
    <div class="row clearfix">
        <div class="col-lg-12 col-md-12 col-sm-12">
            <div class="card">

                <div class="card-body">
                    <div class="row clearfix">
                        <form asp-controller="CustomerProfile" asp-action="AddFolder" enctype="multipart/form-data" method="post">
                            <div class="col-md-12 col-sm-12">
                                <div class="form-group">
                                    <label>Dosya Başlığı </label>
                                    <span class="text-danger" asp-validation-for="CustomerFolder.FolderTitle"></span>
                                    <input type="text" asp-for="CustomerFolder.FolderTitle" required class="form-control">
                                    <input type="hidden" asp-for="CustomerFolder.AdultCustomerID" value="@Model.AdultCustomerDetail.AdultCustomerID">
                                </div>
                            </div>
                            @*<div class="col-md-12 col-sm-12">
                                    <div class="form-group">
                                        <label>Last Name</label>
                                        <input type="text" class="form-control">
                                    </div>
                                </div>*@
                            <div class="col-sm-12">
                                <div class="form-group mt-2 mb-3">
                                    <span class="text-danger" asp-validation-for="CustomerFolder.FolderPath"></span>
                                    <input type="file" asp-for="CustomerFolder.FolderPath" id="fileInput" class="dropify" required name="formFile" onchange="checkFileSize()">
                                    <small id="fileHelp" class="form-text text-muted">Lütfen png, pdf formatında yükleme yapın. Aksi halde kaydetme işlemi başarısız olacaktır. </small>
                                </div>
                            </div>
                            <div class="col-sm-12">
                                <div class="form-group mt-3">
                                    <label>Messages</label>
                                    <span class="text-danger" asp-validation-for="CustomerFolder.FolderDescription"></span>
                                    <textarea rows="4" asp-for="CustomerFolder.FolderDescription" class="form-control no-resize" required placeholder="Lütfen dosya hakkında açıklama yazın"></textarea>
                                </div>
                            </div>
                            <div class="col-sm-12">
                                <button type="submit" class="btn btn-primary">Kaydet</button>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
<script>
    function checkFileSize() {
        const fileInput = document.getElementById('fileInput');
        const file = fileInput.files[0]; // Yüklenen dosyayı alın

        if (file) {
            const maxSizeInBytes = 1073741824; // 1 GB'ın byte cinsinden değeri
            if (file.size > maxSizeInBytes) {

                alert('Dosya boyutu 1 GB\'ı geçemez.');
                fileInput.value = ''; // Dosya seçimini temizleyin
            }
        }
        console.log(fileInput.files[0]);
        if (file.type != "image/png" || file.type != "image/jpg" || file.type != "application/pdf" ) {
          
        } else {
            alert('geçersiz dosya türü! .jpg veya .png  formatında yükleme yapın.');
            fileInput.value = '';
        }
    }

    function checkFileType() {
        var ext = $('#ContentVideoPoster').val().split('.').pop().toLowerCase();
        if ($.inArray(ext, ['gif', 'png', 'jpg', 'jpeg']) == -1) {
            alert('geçersiz dosya türü, Png ve jpg formatında yükleyin!');
        }
    }
</script>

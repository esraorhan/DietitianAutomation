@model UserViewModel

<form asp-action="Edit" asp-controller="User" enctype="multipart/form-data" class="card-body">
    <div class="form-group row">
        <label class="col-md-3 col-form-label">Adı Soyadı <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <input type="text" asp-for="User.FullName" class="form-control" placeholder="Adınız Soyadınız">
        </div>
    </div>
    @Html.HiddenFor(c=>c.User.UserID)
    @Html.HiddenFor(c=>c.User.UserProfileFolder)
    @Html.HiddenFor(c=>c.User.CreationDate)
    @Html.HiddenFor(c=>c.User.Status)
    <div class="form-group row">
        <label class="col-md-3 col-form-label">Email</label>
        <div class="col-md-9">
            <input type="text" asp-for="User.Email" class="form-control" placeholder="Mail Adresiniz">
        </div>
    </div>

    <div class="form-group row">
        <label class="col-md-3 col-form-label">Kullanıcı Rolü <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <select class="form-control input-height" asp-for="User.UserRoleID">
                <option value="">Seçiniz...</option>
                <option value="1">Admin</option>
                <option value="2">Diyetisyen</option>
                <option value="3">Müşteri</option>
            </select>

        </div>
    </div>

    <div class="form-group row">
        <label class="col-md-3 col-form-label">Telefon <span class="text-danger">*</span></label>
        <div class="col-md-9">
            <input type="text" class="form-control" asp-for="User.Phone" placeholder="Telefon numaranız">
            @*<span class="text-danger" asp-validation-for="User.Phone"></span>*@
        </div>
    </div>
    <div class="form-group row">
        <label class="col-md-3 col-form-label">Şifre belirleyin<span class="text-danger">*</span></label>
        <div class="col-md-9">
            <input type="text" asp-for="User.Password" class="form-control">
        </div>
    </div>
    <div class="form-group row">
        <label class="col-md-3 col-form-label">Profil Resminiz</label>
        <div class="col-md-9">
            <input type="file" id="fileInput" asp-for="User.UserProfileFolder" name="formFileEdit" class="dropify" onchange="checkFileSize()">
            <small id="fileHelp" class="form-text text-muted">Profil Resminizi Yükleyebilirsiniz. .png ve ya .jpg formatında olmasına dikkat edin.</small>
        </div>
    </div>
    <div class="form-group row">
        <button type="submit" class="btn btn-primary float-right">Kaydet</button>

    </div>
    <div class="text-danger" asp-validation-summary="All">
        @*model de olsutuduklarıı listelemeleye yarıyor.uyarı dizini olarak*@
    </div>
</form>

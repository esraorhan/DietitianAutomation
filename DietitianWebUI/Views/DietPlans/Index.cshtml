        function PrintPDF() {
            var element = document.getElementById('pdfContent');

            // html2pdf kütüphanesini kullanarak PDF'e dönüştürme
            html2pdf(element, {
                margin: 10,
                filename: 'document.pdf',
                image: { type: 'jpeg', quality: 0.98 },
                html2canvas: { scale: 2 },
                jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }
            }).then(function (pdf) {
                // PDF verisini al ve yeni bir sekmede aç
                var pdfData = pdf.output();
                var blob = new Blob([pdfData], { type: 'application/pdf' });
                var pdfUrl = URL.createObjectURL(blob);

                // Kullanıcıya PDF dosyasını indirmesini sağlayan bir link oluştur
                var downloadLink = document.createElement('a');
                downloadLink.href = pdfUrl;
                downloadLink.download = 'document.pdf';

                // Linki tıklatarak kullanıcıyı indirmeye yönlendir
                downloadLink.click();
            });
        }

        //// dekontu yazdırma işlemi partial view içindeki görüntüyü alma işlemi

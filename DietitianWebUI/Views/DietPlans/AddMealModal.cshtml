@model DietPlanViewModel
<div class="row clearfix">
    <small class="text-danger">** Yemek -Miktar - Ölçü Birimini girdiğiniz de değerler hesaplanacaktır.Sıralamaya Dikkat ediniz.</small>
    <div class="col-lg-12 col-md-12">
        <div class="form-group">
            <label>Öğünler Seç </label>
            @*<span asp-validation-for="Food.CategoryID" class="text-danger"></span>*@
            <select class="form-control input-height" asp-for="DietPlan.MealID" asp-items="Model.Meals">
                <option value="">Seçiniz...</option>
            </select>
        </div>
    </div>
    <div class="col-lg-12 col-md-12">
        <div class="form-group">
            <label>Besinler Listesi </label>
            <span asp-validation-for="DietPlan.FoodID" class="text-danger"></span>
            <select class="form-control input-height" asp-for="DietPlan.FoodID" asp-items="Model.Foods">
                <option value="">Seçiniz...</option>
            </select>
        </div>
        <div class="form-group">
            <label>Besin Notu </label>
            <input type="text" class="form-control" placeholder="Besin Notu" id="BesinAciklama">
            <input type="hidden" name="DiyetSablonID" value="@ViewBag.DiyetSablonID" id="DiyetSablonID" />
        </div>
    </div>
   
    @*<div class="col-lg-6 col-md-12">
        <div class="form-group">
            <label>Ölçü Birimi</label>
            <select class="form-control input-height" name="Olcubirimi" id="OlcuBirimi">
                <option value="">Seçiniz...</option>
                <option value="GR">Gram(GR)</option>
                <option value="Litre(LT)">Litre(LT)</option>
                <option value="Dilim">Dilim</option>
                <option value="Kaşık">Kaşık</option>
                <option value="Kaşık">Tane</option>
                <option value="Porsiyon">Porsiyon</option>
            </select>
            <small id="OlcuBirimiUyari" class="text-danger"></small>
        </div>
    </div>*@
    <div class="col-lg-6 col-md-12">
        <div class="form-group">
            <label>Miktar</label>
            <input type="text" class="form-control" placeholder="Miktar" id="Miktar">
            <small id="MiktarUyari" class="text-danger"></small>
        </div>
    </div>

    <div class="col-lg-3 col-md-12">
        <div class="form-group">
            <label>Kalori</label>
            <input type="number" class="form-control" placeholder="Kalori" id="Kalori">
        </div>
    </div>
    <div class="col-lg-3 col-md-12">
        <div class="form-group">
            <label>Protein</label>
            <input type="number" class="form-control" placeholder="Protein" id="Protein">
        </div>
    </div>
    <div class="col-lg-3 col-md-12">
        <div class="form-group">
            <label>Karbonhidrat</label>
            <input type="number" class="form-control" placeholder="Karbonhidrat" id="Karbonhidrat">
        </div>
    </div>
    <div class="col-lg-3 col-md-12">
        <div class="form-group">
            <label>Yağ</label>
            <input type="number" class="form-control" placeholder="Yağ" id="Yag">
        </div>
    </div>
    <button class="btn btn-outline-success" id="Besinekle"> <i class="fa fa-plus"></i> Ekle</button>
    <div class="card">
        <label>Eklenen Yicekler</label>
        <table id="OzetOgun">
            <thead>
                <tr>
                    <th>Besin Adı</th>
                    <th>Miktarı</th>
                    <th>Kalori</th>
                </tr>
            </thead>

        </table>
    </div>

    <div class="col-lg-12 mt-3">
        <button type="submit" id="kaydet" class="btn btn-primary">Kaydet</button>
        <button type="button" class="close btn btn-light" data-dismiss="modal" aria-label="Close">Vazgeç</button>
    </div>

</div>
<script>
    $("#Miktar").keyup(function () {
        debugger;
        var olcu = $("#OlcuBirimi").val();
        var miktar = $("#Miktar").val();
        var besin = $("#BesinID").val();
        if (miktar == "") {
            $("#MiktarUyari").text("Lütfen Miktar değerini giriniz.");
        } else if (olcu == "") {
            $("#OlcuBirimiUyari").text("Lütfen Ölçü Birimini değerini giriniz.")
        } else if (miktar != null && olcu != "" && besin != null) {
            $.ajax({
                url: "@Url.Action("BesineGoreDegerlergetir", "DiyetSablon")",
                data: { OlcuBirimi: olcu, Miktar: miktar, BesinID: besin },
                type: "GET",
                dataType: "json",
                contentType: "application/json",
                success: function (result) {
                    var res = result.jsonlist;
                    $("#Kalori").val(res.kalori);
                    $("#Protein").val(res.protein);
                    $("#Karbonhidrat").val(res.Karbonhidrat);
                    $("#Yag").val(res.yag);
                }
            });
        }
    });
    var OgunIcerikleri2 = [];

    $("#Besinekle").click(function () {
        OgunIcerikleri = {
            'Kalori': $("#Kalori").val(),
            'Protein': $("#Protein").val(),
            'Karbonhidrat': $("#Karbonhidrat").val(),
            'Yağ': $("#Yag").val(),
            'BesinID': $("#BesinID").val(),
            'OgunID': $("#OgunID").val(),
            'BesinAdi': $("#BesinID option:selected").text(),
            'Miktar': $("#Miktar").val(),
            'BesinAciklama': $("#BesinAciklama").val(),
            'Olcubirimi': $("#OlcuBirimi option:selected").text(),
            'DiyetSablonID': $("#DiyetSablonID").val(),
            'Saat': $("#Saat").val(),
        }
        OgunIcerikleri2.push(OgunIcerikleri);

        for (var i = 0; i < OgunIcerikleri2.length; i++) {
            var o = OgunIcerikleri2[i];
            var html = ' <tbody><tr><td>' + o.BesinAdi + '(' + o.BesinAciklama+')</td>'
                + '<td>' + o.Miktar + '-' + o.Olcubirimi + '</td>'
                + '<td>' + o.Kalori + '</td>' +
           '</tr> </tbody>';
        }
        $("#OzetOgun").append(html);
        $("#Kalori").val("");
        $("#Protein").val("");
        $("#Karbonhidrat").val("");
        $("#Yag").val("");
        $("#Miktar").val("");
        $("#OlcuBirimi").val("");
        $("#BesinAciklama").val("");
        $("#Saat").val("");
    });

    $("#kaydet").click(function () {
        console.log("öğün öğün"+JSON.stringify(OgunIcerikleri2));
        $.ajax({
            type: "POST",
            url: "@Url.Action("OgunEkle", "DiyetSablon")",
            data: {
                ogunmodel: JSON.stringify(OgunIcerikleri2)
            },
            dataType: "json",
            contentType: "application/json;  charset=utf-8",
            success: function (result) {
                window.location.href = result.Locationhref;
            }
        });
    });
</script>

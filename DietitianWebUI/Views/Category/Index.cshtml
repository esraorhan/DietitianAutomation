@model CategoryViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
    <div class="section-body">
        <div class="container-fluid">
            <div class="d-flex justify-content-between align-items-center ">
                <div class="header-action">
                    <h1 class="page-title">Besinler Listesi</h1>
                    <ol class="breadcrumb page-breadcrumb">
                        <li class="breadcrumb-item"><a href="/Anasayfa/Index/">Anasayfa</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Besinler</li>
                    </ol>
                </div>
                <ul class="nav nav-tabs page-header-tab">
                    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#CategoryList">Besin Kategori Listesi</a></li>

                    <li class="nav-item"><a class="nav-link active" id="Library-tab-Boot" data-toggle="tab" href="#NewCategoryList">Yeni Kategori Ekle</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="section-body mt-4">
        <div class="container-fluid">
            <div class="tab-content">
                <div class="tab-pane" id="CategoryList">
                    @await Component.InvokeAsync("CategoryList")
                </div>

                <div class="tab-pane active" id="NewCategoryList">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Yeni Besin Kategori Ekle</h3>
                            <div class="card-options ">
                                <a href="#" class="card-options-collapse" data-toggle="card-collapse"><i class="fe fe-chevron-up"></i></a>
                                <a href="#" class="card-options-remove" data-toggle="card-remove"><i class="fe fe-x"></i></a>
                            </div>
                        </div>

                        <form asp-controller="Category" asp-action="Add" method="post" class="card-body clearfix">
                            @* <div class="text-danger" asp-validation-summary="ModelOnly"></div>*@
                            <div class="form-group row">
                                <label class="col-md-3 col-form-label"> Besin Kategori Adı <span class="text-danger">*</span></label>
                                <div class="col-md-7">
                                    <span class="text-danger" asp-validation-for="Category.CategoryName"></span>
                                    <input type="text" asp-for="Category.CategoryName" class="form-control">
                                </div>
                            </div>
                            <div class="form-group row">
                                <label class="col-md-3 col-form-label">Açıklama<span class="text-danger">*</span></label>
                                <div class="col-md-7">
                                    <span class="text-danger" asp-validation-for="Category.Description"></span>
                                    <input type="text" asp-for="Category.Description" class="form-control">
                                </div>
                            </div>

                            <div class="form-group row">
                                <label class="col-md-3 col-form-label"></label>
                                <div class="col-md-7">
                                    <button type="submit" class="btn btn-primary">Kaydet</button>
                                </div>
                            </div>
                            <div class="text-danger" asp-validation-summary="All">
                                @* model de olsutuduklarıı listelemeleye yarıyor.uyarı dizini olarak*@
                            </div>

                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="centermodal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="myCenterModalLabel"></h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">x</button>
                </div>
                <div class="modal-body">

                     @Html.Partial("EditCategoryViewModal")
                </div>
            </div><!-- /.modal-content -->
        </div><!-- /.modal-dialog -->
    </div><!-- /.modal -->

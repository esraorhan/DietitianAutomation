@model CategoryViewModel
<form asp-controller="Category" asp-action="Edit" method="post" class="card-body clearfix">
    @* <div class="text-danger" asp-validation-summary="ModelOnly"></div>*@
    <div class="form-group row">
        <label class="col-md-3 col-form-label"> Besin Kategori Adı <span class="text-danger">*</span></label>
        <div class="col-md-7">
            <span class="text-danger" asp-validation-for="Category.CategoryName"></span>
            <input type="text" asp-for="Category.CategoryName" class="form-control">
            <input type="hidden" asp-for="Category.CategoryID" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-md-3 col-form-label">Açıklama<span class="text-danger">*</span></label>
        <div class="col-md-7">
            <span class="text-danger" asp-validation-for="Category.Description"></span>
            <input type="text" asp-for="Category.Description" class="form-control">
        </div>
    </div>

    <div class="form-group row">
        <label class="col-md-3 col-form-label"></label>
        <div class="col-md-7">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
    </div>
    <div class="text-danger" asp-validation-summary="All">
        @* model de olsutuduklarıı listelemeleye yarıyor.uyarı dizini olarak*@
    </div>

</form>

